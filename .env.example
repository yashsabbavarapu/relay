# Server-only. When set, every write route requires the header `x-relay-secret: <value>`.
# Never prefix with NEXT_PUBLIC_.
RELAY_API_SECRET=

# Vercel KV (added automatically when a KV database is connected). Unset = in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. 1 = refuse destination URLs on loopback/private addresses (always on when VERCEL is set).
RELAY_BLOCK_PRIVATE_DESTINATIONS=
